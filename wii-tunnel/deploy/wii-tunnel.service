[Unit]
Description=wii-tunnel (outbound WS tunnel to butaningen-relay)
After=network-online.target butaningen.service
Wants=network-online.target

[Service]
Type=simple
User=butaningen
Group=butaningen
EnvironmentFile=/etc/butaningen/wii-tunnel.env
ExecStart=/usr/local/bin/wii-tunnel
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
