# Copy to /etc/butaningen/butaningen.env and chmod 600. NEVER commit real values.
# 実値は絶対にコミットしないこと（CLAUDE.md §4）。

# LINE Messaging API
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# Anthropic API
ANTHROPIC_API_KEY=

# Admin LINE userId (Security/Scope セクションを外した system prompt が適用される)
ADMIN_USER=

# 公開URL（セトリ画像URLの生成に使用）。nginx が https を終端する構成では
# 例: https://your-name.duckdns.org
BOT_EXTERNAL_URL=https://your-name.duckdns.org

# bot がリッスンするポート（nginx がここへ proxy_pass する）
PORT=10000
