[Unit]
Description=butaningen LINE bot (Wii)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=butaningen
Group=butaningen
EnvironmentFile=/etc/butaningen/butaningen.env
ExecStart=/usr/local/bin/butaningen
Restart=always
RestartSec=3

# Hardening. PrivateTmp gives the process its own /tmp; the bot both writes
# setlist PNGs there and serves them over HTTP from the same namespace, so the
# private /tmp is self-consistent.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
